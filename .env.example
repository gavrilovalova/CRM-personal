# Copy to .env and fill in. Never commit .env
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# postgresql://<user>:<password>@localhost:<port>/<db>
DATABASE_URL=
# Login and password for the temporary HTTP Basic Auth (proxy.ts).
# Required in production; leave empty locally to open the app without a password
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
